{
  "name": "motherboard",
  "private": true,
  "version": "0.1.0",
  "description": "Motherboard — full-stack AI life & home management app (mobile + web)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev:mobile": "pnpm --filter @motherboard/mobile start",
    "dev:web": "pnpm --filter @motherboard/web dev",
    "build:web": "pnpm --filter @motherboard/web build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "supabase:start": "supabase start",
    "supabase:migrate": "supabase db push",
    "supabase:gen-types": "supabase gen types typescript --local > packages/shared/src/database.types.ts"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  }
}
